# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the models (defaults shown). The fallback is used when the
# primary model is rate limited or unavailable.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Gmail Configuration (for sending results email)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# HR Email (where to send screening results)
HR_EMAIL=hr_team@example.com

# Optional security (see README "Security")
# Origins allowed to call the API from a browser, comma-separated. Unset = any origin.
ALLOWED_ORIGINS=https://your-app.lovable.app
# Shared password for the web app (/app). When set, the API requires a session from /api/login.
APP_PASSWORD=
# For server-to-server callers: requests may send this in the x-api-key header instead.
# Keep it server-side; never put it in browser code.
API_KEY=
